# Auto detect text files and perform LF normalization
* text=auto

# Keep LF endings for the files the launcher patches at runtime (DshPatcher does
# LF-based string matching against the DSH package JS/YAML) and for web assets.
# Without eol=lf, a Windows checkout with core.autocrlf=true rewrites these to
# CRLF and the patches silently fail to match.
node/** text eol=lf
gui-cs/src/wwwroot/** text eol=lf
**/*.js text eol=lf
**/*.mjs text eol=lf
**/*.cjs text eol=lf
**/*.json text eol=lf
**/*.yml text eol=lf
**/*.yaml text eol=lf
**/*.html text eol=lf
**/*.css text eol=lf

# Shell scripts must stay LF on checkout (they run on Linux/macOS); Windows
# batch files stay CRLF.
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.vbs text eol=crlf

# Binary assets MUST NOT be EOL-normalized. The `node/** text eol=lf` rule above
# also matches the bundled Node/DSH archives under node/platforms/ and would
# corrupt them on commit (they are gzip/xz). These `binary` (= -text -diff) rules
# come AFTER, so they win.
node/platforms/** binary
**/*.node binary
**/*.exe binary
**/*.dll binary
**/*.so binary
**/*.dylib binary
**/*.wasm binary
**/*.tar binary
**/*.tar.xz binary
**/*.tar.gz binary
**/*.tgz binary
**/*.xz binary
**/*.gz binary
**/*.zip binary
**/*.7z binary
**/*.png binary
**/*.jpg binary
**/*.jpeg binary
**/*.gif binary
**/*.ico binary
**/*.webp binary
**/*.pdf binary
**/*.woff binary
**/*.woff2 binary
**/*.ttf binary
**/*.otf binary
**/*.db binary
**/*.sqlite binary
