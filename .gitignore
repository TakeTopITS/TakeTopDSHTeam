*.msp

# JetBrains Rider
*.sln.iml

# ---- TakeTopDSH Team: secrets & per-user runtime data (do NOT publish) ----
# Per-user DSH instance runtime data (workspaces, sessions, credentials)
/instances/
# .dsh/.credentials.yaml IS published (ph- placeholder keys, safe to share) so a
# fresh clone starts DSH with a placeholder API key + random session secret the
# admin replaces with a real key. Only per-user session data is excluded.
.dsh/sessions/
.dsh/storages/
.dsh/.anonymous-user-id
# Config files that hold per-instance OS passwords / token URLs (runtime-generated)
config/instances.json
config/users.json
# Renamed legacy copies after migration to config/launcher.db (kept for rollback)
config/*.bak
# Internal development session/work logs (not project docs)
/docs/
# Compiled launcher output — ignore build intermediates but KEEP the self-contained
# publish folders so a fresh clone runs out of the box without the .NET SDK.
# start.sh (Linux/macOS) uses dsh-launcher/linux-x64, linux-arm64 and osx-arm64;
# start.bat (Windows) uses dsh-launcher/win-x64. All four platform folders are
# TRACKED so a fresh clone needs no compilation and no .NET SDK.
gui-cs/src/obj/
*.pdb
# Local secrets
.env
*.local

# SQLite task/feedback databases + WAL sidecar files (per-user runtime data;
# the legacy XML is auto-imported and archived as *.xml.bak on first run).
*.db
*.db-wal
*.db-shm
*.db.bak
*.xml.bak

# Default workspace/data directory inside the install dir (runtime data: DB,
# task/feedback attachments). Must never be committed.
/WorkSpace/

# Root single-file launcher is a build artifact (>100 MiB, over GitHub's
# per-file limit). Do not track it; users run start.bat, which uses the tracked
# self-contained publish folder under gui-cs/src/bin/.../win-x64/publish/.
/TakeTopDshLauncher.exe

# ---- Runtime / credential data (auto-regenerated on first launch) ----
# These are rebuilt automatically by the launcher, so they are safe to exclude
# from the repo. Applies to clone-and-run: the app creates/derives them on boot.
config/instances.json
config/users.json
# NOTE: .dsh/.credentials.yaml is NOT checked in — it contains the REAL DeepSeek
# API key + session secret the admin configures. The launcher auto-generates a
# placeholder version (ph-... ) on first boot so a fresh clone can start; the
# admin then sets the real key in the DSH UI.
.dsh/.credentials.yaml
.dsh/launcher-token.txt
.dsh/.anonymous-user-id
.dsh/sessions/
.dsh/storages/
# .dsh/profiles/node_modules is a DSH-managed symlink/module-proxy tree that DSH
# recreates from node/ on boot. It must NOT be checked in: git turns the cascade
# of junctions into real directories on clone, which makes DSH abort
# ("exists and is not a symlink or dsh-managed module proxy"). Keep the rest of
# .dsh/profiles (web/ templates, etc.) trackable.
.dsh/profiles/node_modules/
/instances/
/logs/
*.log
# Build output (bin/) is ignored. The self-contained launchers are TRACKED under
# dsh-launcher/win-x64/ (Windows), linux-x64, linux-arm64 and osx-arm64, so a
# fresh clone has the launcher exe for its platform and runs out of the box
# without needing the .NET SDK.
