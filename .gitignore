## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results — anchored to the repo root ("/") so these do NOT match npm
# packages named debug/release/express/etc. nested under node/ or .dsh/.
/[Dd]ebug/
/[Dd]ebugPublic/
/[Rr]elease/
/[Rr]eleases/
/x64/
/x86/
/[Ww][Ii][Nn]32/
/[Aa][Rr][Mm]/
/[Aa][Rr][Mm]64/
/bld/
/[Bb]in/
/[Oo]bj/
/[Ll]og/
/[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/
