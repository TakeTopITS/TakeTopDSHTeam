<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Host without a console window (no black cmd window when started). -->
    <OutputType>WinExe</OutputType>
    <!-- Single source of truth for the app version (SemVer). Bump here and
         republish; /api/version + the UI read this. Also drives the exe's
         file properties (Assembly/File/Informational version). -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <Product>TakeTopDSH Team</Product>
    <Company>泰顶拓鼎信息科技（上海）有限公司</Company>
    <Copyright>Copyright © 2026-2036 泰顶拓鼎信息科技（上海）有限公司</Copyright>
  </PropertyGroup>

</Project>
